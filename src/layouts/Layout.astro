---
// Supports weights 100-900
import "@fontsource-variable/urbanist";
import "@fontsource-variable/jost";

import "../css/reset.css";
import "../css/shared-values.css";
import "../css/layout.css";
import "../css/typography.css";
import "../css/main.css";

const { context } = Astro.props;

const isActive = (c: Page) => (c === context ? true : false);
const setClass = (c: Page) => {
  const base = "header__item";
  if (isActive(c)) {
    return `${base} ${base}--active`;
  }
  return base;
};

const setCardsClass = () => {
  if (isActive("PHOTOS")) {
  return "cards-content";
  }
  return "";
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Decio's web</title>
  </head>
  <body class={setCardsClass()}>
    <header class="main-block">
      <a class={setClass("INDEX")} href="/"> Home</a>
      <a class={setClass("PHOTOS")} href="/photos">Photography</a>
    </header>
    <slot />
    <footer class="main-block">
      <ul class="icons">
        <li>
          <a rel="me" href="https://github.com/deciob">
            <img src="/github-mark.png" alt="github" /></a
          >
        </li>
      </ul>
    </footer>
  </body>
</html>

<style></style>
